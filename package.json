{
  "name": "routefolio",
  "version": "1.0.0",
  "private": true,
  "description": "Web app that generates a monochrome section route diagram for print from a GPX file",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5005",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5005",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "canvg": "^4.0.3",
    "pbf": "^5.1.2",
    "topojson-client": "^3.1.0",
    "tz-lookup": "^6.1.25",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  }
}
